config fancontrol 'main'
	option enabled '1'
	option manual_mode '0'
	option thermal_file '/sys/class/thermal/thermal_zone0/temp'
	option fan_pwm_file '/sys/class/hwmon/hwmon2/pwm1'
	option pwm_enable_file '/sys/class/hwmon/hwmon2/pwm1_enable'
	option temp_div '1000'
	option start_temp '45'
	option max_speed '255'
	option quiet_pwm '80'
	option balanced_pwm '140'
	option turbo_pwm '220'
	option manual_pwm '140'
	option pwm_enable_manual_value '1'
	option pwm_enable_auto_value '2'

